# ===========================================================================
#  Dream AI · Web service configuration
#  Copy this file to `.env` and fill in the real values. `.env` is git-ignored
#  and is never sent to the browser.
# ===========================================================================

# ---------- Site-provided free model (OpenAI-compatible) ----------
# The default is Zhipu GLM-4-Flash. Any compatible endpoint works.
# DeepSeek       : https://api.deepseek.com/v1
# OpenAI         : https://api.openai.com/v1
# Alibaba Bailian: https://dashscope.aliyuncs.com/compatible-mode/v1
DREAMAI_FREE_API_KEY=
DREAMAI_FREE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DREAMAI_FREE_MODEL=glm-4-flash
DREAMAI_FREE_LABEL=GLM-4-Flash
DREAMAI_FREE_KEY_URL=https://open.bigmodel.cn/usercenter/apikeys

# ---------- Bring-your-own-key (BYOK) models ----------
DREAMAI_BYOK_BASE_URL=https://api.deepseek.com/v1
DREAMAI_BYOK_MODELS=deepseek-chat|DeepSeek V3|0,deepseek-reasoner|DeepSeek R1|1
DREAMAI_BYOK_LABEL=DeepSeek
DREAMAI_BYOK_KEY_URL=https://platform.deepseek.com/api_keys

# ---------- Generation ----------
DREAMAI_TEMPERATURE=0.7
DREAMAI_MAX_TOKENS=4096

# ---------- Abuse protection ----------
# Per-IP sliding window: at most DREAMAI_RATE_LIMIT messages per window.
DREAMAI_RATE_LIMIT=30
DREAMAI_RATE_WINDOW=600
# Global daily budget for the site-provided free model. 0 disables the cap.
DREAMAI_DAILY_LIMIT=2000
# Concurrent model requests.
DREAMAI_MAX_CONCURRENCY=6
# Per-message and context limits.
DREAMAI_MAX_INPUT_CHARS=12000
DREAMAI_MAX_HISTORY_MESSAGES=30
DREAMAI_MAX_HISTORY_CHARS=60000

# ---------- Site identity ----------
DREAMAI_SITE_TITLE=Dream AI
DREAMAI_SITE_TAGLINE=让每一个想法，都被认真对待
DREAMAI_REPO_URL=https://github.com/Li-Guijiang/DreamAI

# ---------- Optional persona (single line) ----------
# The default prompt already fixes the owner/creator as 李贵江.
# DREAMAI_SYSTEM_PROMPT=你是 Dream AI……
# Optional non-sensitive owner context appended to the system prompt.
# Never put phone numbers, private emails, health or financial data here:
# this context is sent to the model provider. Keep full contact details in a
# private file outside the repository.
# DREAMAI_OWNER_PROFILE=李贵江，19岁，计算机专业学生……
