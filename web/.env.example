# ===========================================================================
#  Dream AI · web service configuration
#  Copy to .env and fill in real values. .env is never committed and never
#  reaches the browser.
#
#  Two model sources:/n#    free -- a model the site provides, Zhipu GLM-4-Flash by default (free tier)
#    byok -- the visitor's own DeepSeek key, forwarded per request, never stored
# ===========================================================================

# ---------- Free model (site default) ----------
# Zhipu platform: https://open.bigmodel.cn -> API Keys
DREAMAI_FREE_API_KEY=
DREAMAI_FREE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DREAMAI_FREE_MODEL=glm-4-flash
DREAMAI_FREE_LABEL=GLM-4-Flash
DREAMAI_FREE_KEY_URL=https://open.bigmodel.cn/usercenter/apikeys

# Alternatively use a SiliconFlow free model:
# DREAMAI_FREE_BASE_URL=https://api.siliconflow.cn/v1
# DREAMAI_FREE_MODEL=Qwen/Qwen2.5-7B-Instruct
# DREAMAI_FREE_LABEL=Qwen2.5-7B
# DREAMAI_FREE_KEY_URL=https://cloud.siliconflow.cn/account/ak

# ---------- Bring your own key (BYOK) ----------
DREAMAI_BYOK_BASE_URL=https://api.deepseek.com/v1
DREAMAI_BYOK_MODELS=deepseek-chat|DeepSeek V3|0,deepseek-reasoner|DeepSeek R1|1
DREAMAI_BYOK_KEY_URL=https://platform.deepseek.com/api_keys
DREAMAI_BYOK_LABEL=DeepSeek

# ---------- Site identity ----------
DREAMAI_SITE_TITLE=Dream AI
DREAMAI_SITE_TAGLINE=让每一个想法，都被认真对待
DREAMAI_REPO_URL=https://github.com/Li-Guijiang/DreamAI

# ---------- Generation ----------
DREAMAI_TEMPERATURE=0.7
DREAMAI_MAX_TOKENS=4096

# ---------- Abuse protection ----------
# Each IP may start DREAMAI_RATE_LIMIT conversations per DREAMAI_RATE_WINDOW seconds
DREAMAI_RATE_LIMIT=30
DREAMAI_RATE_WINDOW=600
# Global daily cap for the free model (BYOK requests are excluded)
DREAMAI_DAILY_LIMIT=600
# Maximum concurrent upstream requests
DREAMAI_MAX_CONCURRENCY=6
# Maximum characters per message
DREAMAI_MAX_INPUT_CHARS=12000
# Context: maximum history messages and total characters
DREAMAI_MAX_HISTORY_MESSAGES=30
DREAMAI_MAX_HISTORY_CHARS=60000

# ---------- Optional: custom persona (must be a single line) ----------
# DREAMAI_SYSTEM_PROMPT=You are Dream AI...
