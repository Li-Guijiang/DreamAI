# ===========================================================================
# Dream AI configuration — copy this file to `.env` and fill in your values.
# `.env` is git-ignored and must never be committed.
# ===========================================================================

# LLM provider: "openai_compat" (any OpenAI-compatible API) | "local" (offline demo)
DREAMAI_PROVIDER=openai_compat

# Base URL of any OpenAI-compatible endpoint:
#   OpenAI     : https://api.openai.com/v1
#   DeepSeek   : https://api.deepseek.com/v1
#   Qwen/DashScope compatible mode: https://dashscope.aliyuncs.com/compatible-mode/v1
DREAMAI_BASE_URL=https://api.deepseek.com/v1

# Your API key (required for the openai_compat provider). Leave empty to fall
# back to the offline local provider for testing.
DREAMAI_API_KEY=

# Model name provided by the endpoint above.
DREAMAI_MODEL=deepseek-chat

# System prompt that shapes Dream AI's persona and behavior.
DREAMAI_SYSTEM_PROMPT=You are Dream AI, a helpful, honest, and capable general-purpose assistant. Think clearly, answer truthfully, and admit when you are unsure.

# ===========================================================================
# Memory (v0.2)
# ===========================================================================

# Persist the session history and preferences to disk between runs.
# true (default): restore the last conversation and remembered preferences.
# false: keep everything in memory for the current process only.
DREAMAI_PERSISTENCE=true

# Directory where session.json and preferences.json are stored.
# Default: ~/.dream_ai (your home directory). Set a relative path for a
# local, project-scoped data folder such as .dream_ai/.
# DREAMAI_DATA_DIR=.dream_ai

# ===========================================================================
# Tools (v0.3)
# ===========================================================================

# Master switch for the tool registry. false: no tools are registered at all.
DREAMAI_TOOLS_ENABLED=true

# Sandboxed file read/write. Off by default; paths are confined to the
# workspace directory below.
DREAMAI_FILE_ACCESS_ENABLED=false

# Instant-answer web search. Off by default; requires network access.
DREAMAI_WEB_SEARCH_ENABLED=false

# Directory that file tools are allowed to read and write.
# Default: <data_dir>/workspace
# DREAMAI_WORKSPACE_DIR=.dream_ai/workspace

# ===========================================================================
# Autonomy (v0.4)
# ===========================================================================

# Master switch for autonomous multi-step execution.
DREAMAI_AUTONOMY_ENABLED=true

# Maximum number of tool actions per autonomous run. The loop stops when this
# budget is exhausted so a plan cannot run away.
DREAMAI_MAX_STEPS=10

# Extra retries after a tool failure, per plan step (0 = no retry).
DREAMAI_MAX_RETRIES=2

# Print every think/act/observe/reflect event live while a task runs.
DREAMAI_AUTONOMY_VERBOSE=false

# ===========================================================================
# Terminal motion
# ===========================================================================

# Animated launch sequence, typing replies, and the live thinking spinner.
# "auto" (default) only animates in an interactive terminal; set to false for
# logs, CI, screen readers, or recordings that need stable line output.
# You can also pass --no-animation to a single run, or use /motion in-chat.
DREAMAI_ANIMATIONS=auto

# Speed multiplier for terminal effects: 0.25 (slow) .. 4.0 (fast), default 1.0.
DREAMAI_ANIMATION_SPEED=1.0
