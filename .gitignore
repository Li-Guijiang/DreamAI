# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging (Python build output at the repository root only;
# the rules are anchored so they cannot hide desktop/build or web build assets)
/build/
/dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables (never commit secrets)
.env
.env.local
.env.*.local

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# Type checkers / linters / formatters
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Project runtime data
data/
logs/
*.log
build_log.txt
*.sqlite3
*.db

# Scratch output from local release and debug runs.
# The file names used to be listed one by one (probe.txt, poll2.txt, final9.txt,
# v4check.txt, ...), which grew without bound. They were all repository-root text
# dumps produced by manual GitHub CLI sessions, so a single anchored pattern
# covers them; tracked files such as requirements.txt are exempted explicitly.
/*.txt
!/requirements.txt
!/requirements-dev.txt
/run_logs/
/run_logs.zip
/_demo*.py

# Model / cache files (large binaries)
.cache/
models/
*.bin
*.gguf
*.safetensors

# Local agent memory (session history and preferences)
.dream_ai/
session.json
preferences.json

# Web app (Node build artefacts / local runtime)
web/downloads/*.exe
web/data/
web/.venv/
web/node_modules/

# Desktop app
desktop/node_modules/
desktop/release/
desktop/test/shots/

# Nested static site downloads
web/web/downloads/*.exe
