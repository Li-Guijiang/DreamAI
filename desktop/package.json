{
  "name": "dream-ai-desktop",
  "version": "1.4.0",
  "private": true,
  "description": "Dream AI desktop - local file workbench",
  "main": "electron/main.js",
  "author": {
    "name": "Li Guijiang",
    "url": "https://github.com/Li-Guijiang"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:local": "electron . --url=http://127.0.0.1:8787",
    "dist": "electron-builder --win nsis --x64",
    "pack": "electron-builder --dir",
    "test": "node test/local-tools.test.js && node test/documents.test.js && node test/update.test.js",
    "test:tools": "node test/local-tools.test.js",
    "test:docs": "node test/documents.test.js",
    "test:update": "node test/update.test.js"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.dreamai.desktop",
    "productName": "Dream AI",
    "copyright": "Copyright © 2026 Li Guijiang",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DreamAI-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dream AI",
      "uninstallDisplayName": "Dream AI"
    }
  },
  "dependencies": {
    "docx": "^9.14.0",
    "exceljs": "^4.4.0",
    "pptxgenjs": "^4.0.1"
  }
}
